# ─── Xcode ───────────────────────────────────────────────────────────────
# The .xcodeproj is generated by XcodeGen from project.yml — never commit it.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ─── Swift Package Manager ───────────────────────────────────────────────
.build/
.swiftpm/
Package.resolved

# ─── Generated by XcodeGen ──────────────────────────────────────────────
Sources/App/Info.plist
Sources/App/Aeria.entitlements
Sources/Widgets/Info.plist
Sources/Widgets/AeriaWidgets.entitlements
Sources/Watch/Info.plist
Sources/ShareExtension/Info.plist
Sources/ShareExtension/AeriaShare.entitlements

# ─── Secrets (never commit API keys) ────────────────────────────────────
Secrets.xcconfig
*.env
Config/Secrets*.plist

# ─── macOS / editor cruft ───────────────────────────────────────────────
.DS_Store
*.swp
.idea/
*.orig
